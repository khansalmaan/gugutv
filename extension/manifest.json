{
  "manifest_version": 3,
  "name": "GuguTV",
  "version": "0.2.0",
  "description": "Synchronize HTML5 video playback with a room.",
  "permissions": ["storage", "activeTab", "alarms"],
  "host_permissions": ["https://gugutv.onrender.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GuguTV",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:8081/*", "http://127.0.0.1:8081/*", "*://*.hotstar.com/*", "*://*.primevideo.com/*", "*://*.amazon.com/gp/video/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
